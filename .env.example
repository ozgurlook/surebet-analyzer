# Server invite / registration secret (required for new signups)
# Generate a strong key for production (e.g. openssl rand -base64 24)
SUREBET_REGISTRATION_CODE="choose-your-secure-invite-code"

# Shared Telegram Bot Token from @BotFather (optional, enables per-user alerts)
SUREBET_TELEGRAM_BOT_TOKEN=""

# Set to "true" when running behind HTTPS in production for Secure session cookies
SUREBET_COOKIE_SECURE="false"

# Production hostname for Caddy HTTPS (DNS A record must point to the VM)
SUREBET_DOMAIN="surebet.example.com"

# Source endpoints. The repository ships no provider hosts; a source without an
# ENDPOINT reports "endpoint not configured" on the health page. Demo mode
# (`surebet-web serve --demo`) needs none of these.
# Keys per source: <P>ENDPOINT (wss:// or https://), <P>ORIGIN, <P>PAGE_URL,
# <P>REALM (WAMP-feed sources) and <P>OPERATOR_ID (WAMP-feed sources
# and Source A's JSON-RPC site id), where <P> is
# SUREBET_SOURCE_A_ ... SUREBET_SOURCE_F_. See src/surebet/sources/endpoints.py.
SUREBET_SOURCE_A_ENDPOINT=""
SUREBET_SOURCE_A_OPERATOR_ID=""
SUREBET_SOURCE_B_ENDPOINT=""
SUREBET_SOURCE_B_REALM=""
SUREBET_SOURCE_B_OPERATOR_ID=""
